# El secreto de pagoradar NO va aquí: cada conjunto tiene el suyo, guardado cifrado en la base de datos
# (Ajustes del panel, o `npm run admin -- configurar-pagoradar`).
# URL pública de Cuotia (cookies seguras y enlaces). Con https:// las cookies llevan Secure.
PUBLIC_URL=http://localhost:3000
# Cifra en la base de datos los secretos del doble factor. openssl rand -hex 32  — guárdala: sin ella nadie puede entrar.
MASTER_KEY=
# Opcional (mínimo 16 caracteres): fija el enlace /setup?token=… del primer conjunto. Vacío = se genera uno en cada arranque y se imprime en el log.
SETUP_TOKEN=
# Correo al que los titulares pueden escribir para ejercer sus derechos sobre sus datos (Ley 1581). Opcional.
PRIVACY_CONTACT=
PORT=3000
DATABASE_PATH=./data/cuotia.db
# Carpeta de las copias de seguridad que se hacen antes de borrar datos (por defecto, "backups" junto a la base).
BACKUP_DIR=

# Respaldos fuera del servidor (opcional pero recomendado): cada noche Cuotia sube una copia CIFRADA con tu MASTER_KEY a
# cualquier almacenamiento compatible con S3. Hasta 3 destinos (BACKUP1_, BACKUP2_, BACKUP3_). Ejemplo con Cloudflare R2 y Backblaze B2:
#   BACKUP1_NAME=Cloudflare R2
#   BACKUP1_ENDPOINT=https://<ID_DE_CUENTA>.r2.cloudflarestorage.com
#   BACKUP1_BUCKET=cuotia-respaldos
#   BACKUP1_REGION=auto
#   BACKUP1_KEY_ID=<Access Key ID del token S3 de R2>
#   BACKUP1_SECRET=<Secret Access Key>
#   BACKUP2_NAME=Backblaze B2
#   BACKUP2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
#   BACKUP2_BUCKET=cuotia-respaldos-b2
#   BACKUP2_REGION=us-west-004
#   BACKUP2_KEY_ID=<keyID de la application key>
#   BACKUP2_SECRET=<applicationKey>
# Cuántas copias se conservan en cada destino (las más nuevas):
BACKUP_KEEP=30

